(version 1)
# Different input domains can differ by200V under simultaneous+100V/-100V faults.
(rule "Fault domains ESTOP / IN1:200V"
  (condition "((A.NetName == '/15 | NC emergency-stop field loop/IN9_WET_COLLECTOR' || A.NetName == 'ESTOP_CHAIN_OUT' || A.NetName == 'ESTOP_FIELD' || A.NetName == 'Net-(D119-K)' || A.NetName == 'Net-(D129-A)' || A.NetName == 'Net-(R1244-Pad2)' || A.NetName == 'Net-(R1245-Pad2)' || A.NetName == 'Net-(R1254-Pad2)' || A.NetName == 'Net-(R1255-Pad2)') && (B.NetName == '/11 | Wetting sources 1-2/IN1_WET_COLLECTOR' || B.NetName == 'IN1_FIELD' || B.NetName == 'Net-(D111-K)' || B.NetName == 'Net-(D121-A)' || B.NetName == 'Net-(R1004-Pad2)' || B.NetName == 'Net-(R1005-Pad2)' || B.NetName == 'Net-(R1014-Pad2)' || B.NetName == 'Net-(R1015-Pad2)')) || ((A.NetName == '/11 | Wetting sources 1-2/IN1_WET_COLLECTOR' || A.NetName == 'IN1_FIELD' || A.NetName == 'Net-(D111-K)' || A.NetName == 'Net-(D121-A)' || A.NetName == 'Net-(R1004-Pad2)' || A.NetName == 'Net-(R1005-Pad2)' || A.NetName == 'Net-(R1014-Pad2)' || A.NetName == 'Net-(R1015-Pad2)') && (B.NetName == '/15 | NC emergency-stop field loop/IN9_WET_COLLECTOR' || B.NetName == 'ESTOP_CHAIN_OUT' || B.NetName == 'ESTOP_FIELD' || B.NetName == 'Net-(D119-K)' || B.NetName == 'Net-(D129-A)' || B.NetName == 'Net-(R1244-Pad2)' || B.NetName == 'Net-(R1245-Pad2)' || B.NetName == 'Net-(R1254-Pad2)' || B.NetName == 'Net-(R1255-Pad2)'))")
